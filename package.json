{
  "name": "acoustsee",
  "version": "0.8.6",
  "description": "AcoustSee: Audio-Visual Synthesis Interface",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "inject-build": "node ./scripts/codegen/inject-build-info.js",
    "serve": "npm run inject-build && python3 -m http.server 8000",
    "serve-debug": "npm run inject-build && python3 -m http.server 8000",
    "test": "jest --config jest.config.cjs",
    "test:unit": "jest --config jest.config.cjs --testPathPattern=future/web/test --runInBand",
    "test:e2e": "npx playwright test --config=playwright.config.cjs",
    "playwright:install": "npx playwright install",
    "start:static": "node ./scripts/infrastructure/static-server.cjs",
    "test:e2e:http": "npx playwright test --config=playwright.config.cjs",
    "collect:artifacts": "node ./scripts/infrastructure/collect-artifacts.cjs",
    "validate:bootstrap": "node scripts/validation/validate-bootstrap-imports.js"
  },
  "keywords": ["accessibility", "sonification", "audio", "video", "computer-vision"],
  "author": "MAMware",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@playwright/test": "^1.54.2",
    "babel-jest": "^29.6.0",
    "eslint-plugin-jsonc": "^2.16.0",
    "jest": "^29.6.0",
    "jest-environment-jsdom": "^29.6.0",
    "jsdom": "^22.1.0"
  }
}
